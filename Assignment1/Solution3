import java.io.*;

class NumberAnalysis {
    static int rev(int n) {
        int r = 0;
        while (n > 0) {
            r = r * 10 + n % 10;
            n /= 10;
        }
        return r;
    }

    static boolean prime(int n) {
        if (n < 2) return false;
        int i = 2;
        while (i <= n / 2) {
            if (n % i == 0) return false;
            i++;
        }
        return true;
    }

    static int sum(int n) {
        int s = 0;
        while (n > 0) {
            s += n % 10;
            n /= 10;
        }
        return s;
    }

    static boolean armstrong(int n) {
        int x = n, s = 0;
        while (n > 0) {
            int d = n % 10;
            s += d * d * d;
            n /= 10;
        }
        return x == s;
    }

    public static void main(String[] args) throws IOException {
        BufferedReader br = new BufferedReader(new InputStreamReader(System.in));
        int ch;

        do {
            System.out.print("Enter number: ");
            int n = Integer.parseInt(br.readLine());

            System.out.println("\n1.Prime  2.Palindrome  3.Armstrong");
            System.out.println("4.Sum Digits  5.Reverse  6.Exit");
            System.out.print("Choice: ");
            ch = Integer.parseInt(br.readLine());

            if (ch == 1)
                System.out.println(prime(n) ? "Prime" : "Not Prime");
            else if (ch == 2)
                System.out.println(n == rev(n) ? "Palindrome" : "Not Palindrome");
            else if (ch == 3)
                System.out.println(armstrong(n) ? "Armstrong" : "Not Armstrong");
            else if (ch == 4)
                System.out.println("Sum = " + sum(n));
            else if (ch == 5)
                System.out.println("Reverse = " + rev(n));
            else if (ch == 6)
                System.out.println("Exit");
            else
                System.out.println("Invalid Choice");

        } while (ch != 6);
    }
}
